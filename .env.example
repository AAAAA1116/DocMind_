# 复制成 .env 后填自己的值（.env 已被 .gitignore 忽略，不会提交）

# 对话模型（第四阶段起）。必填。
DEEPSEEK_API_KEY=your_key_here

# 精排 API（v1.8 起）。config.RERANK_PROVIDER 指向哪家就填哪家：
#   siliconflow -> SILICONFLOW_API_KEY  （默认；bge-reranker-v2-m3 在该平台是免费模型）
#   dashscope   -> DASHSCOPE_API_KEY
#   local       -> 不需要 key（本地跑 bge-reranker-v2-m3，但要 2.3GB 内存）
# 只配 DEEPSEEK 也能跑：精排失败会自动降级为「按 RRF 名次取前 TOP_K 个」，问答不中断。
SILICONFLOW_API_KEY=your_key_here
DASHSCOPE_API_KEY=your_key_here
